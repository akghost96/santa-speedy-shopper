{
  "id": "santa-catalog",
  "name": "Santa Catalog",
  "description": "Native Shopify Global Catalog search (US/USD) plus per-call request shaping for Kimi on Cerebras.",
  "activation": {
    "onStartup": true
  },
  "providers": [
    "cerebras"
  ],
  "providerEndpoints": [
    {
      "endpointClass": "cerebras-native",
      "hosts": [
        "api.cerebras.ai"
      ]
    }
  ],
  "providerRequest": {
    "providers": {
      "cerebras": {
        "family": "cerebras"
      }
    }
  },
  "contracts": {
    "tools": [
      "search_catalog"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "firstCallToolChoice": {
        "type": "string",
        "enum": [
          "required",
          "auto"
        ]
      },
      "maxCompletionTokens": {
        "type": "integer",
        "minimum": 64
      },
      "payloadLog": {
        "type": "string"
      },
      "promptHint": {
        "type": "boolean"
      },
      "fewShot": {
        "type": "boolean"
      },
      "scriptedThoughts": {
        "type": "boolean"
      },
      "resultFormat": {
        "type": "string",
        "enum": [
          "lines",
          "json"
        ]
      },
      "payloadDump": {
        "type": "string"
      },
      "queueRetry": {
        "type": "boolean"
      },
      "queueRetryAttempts": {
        "type": "integer",
        "minimum": 1
      },
      "queueRetryDelayMs": {
        "type": "integer",
        "minimum": 100
      },
      "queueStallMs": {
        "type": "integer",
        "minimum": 0
      },
      "thoughtCall": {
        "type": "string"
      },
      "thoughtAnswer": {
        "type": "string"
      },
      "preambleCall": {
        "type": "string"
      }
    }
  },
  "toolMetadata": {
    "search_catalog": {
      "profiles": [
        "minimal"
      ]
    }
  }
}
